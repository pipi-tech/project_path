# Python
__pycache__/
*.pyc
.venv/
env/

# Log input data (runtime state — append-only, not versioned)
data/log/*/input/
data/data/

# Master output files (generated)
data/log/MasterLOGText/
data/log/MasterSCRText/
data/log/MasterTree/

# Dep snapshot artifacts
data/log/dep/src/*.bak

# Keep the log src scripts and empty input dirs
!data/log/*/src/
!data/log/*/input/.gitkeep

# Backup files
*.backup_*
