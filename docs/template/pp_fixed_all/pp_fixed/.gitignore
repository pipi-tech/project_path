# Python
__pycache__/
*.pyc
.venv/
env/

# Log content — keep structure, ignore data files
data/log/**/input/*.txt
data/log/**/output/*.txt
data/log/**/output/*.log
!data/log/**/.gitkeep

# Master reference outputs (regenerated on demand)
data/MasterSCRText/
data/MasterLOGText/
data/log/MasterSCRText/
data/log/MasterLOGText/

# Temp / runtime
*.tmp
*.lock
/tmp/

# Registry runtime backups
data/*.backup_*
**/*.backup_*

# Session temp files
/tmp/pp_session_*.hash
/tmp/pp_doc_sessions/

# Node
node_modules/

# Editor
.vscode/
*.swp
